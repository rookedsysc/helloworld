[mysqld]
# 1글자 검색이 목적이므로 ngram 토큰 크기를 1로 둔다.
# 이 값은 서버 재시작과 FULLTEXT 인덱스 재생성을 요구하므로 최초 기동부터 고정한다.
ngram_token_size = 1

# 10만건(원문 2.25GB) 기준 인덱스가 버퍼풀을 초과하도록 두어 디스크 I/O가 실제로 발생하게 한다.
innodb_buffer_pool_size = 2G

# FULLTEXT 인덱스 일괄 빌드 시 사용하는 캐시. 1-gram은 토큰 수가 많아 기본값으로는 병목이 된다.
innodb_ft_cache_size = 64000000
innodb_ft_total_cache_size = 1600000000

# 문서당 최대 1만자(UTF-8 약 30KB)를 배치 INSERT로 넣기 때문에 패킷 상한을 올린다.
max_allowed_packet = 256M

# 벌크 적재 구간의 디스크 동기화 비용을 낮춘다. 벤치마크 전용 설정이며 운영 환경에는 적합하지 않다.
innodb_flush_log_at_trx_commit = 2
